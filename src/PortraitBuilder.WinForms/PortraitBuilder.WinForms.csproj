<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ForceDesignerDpiUnaware>true</ForceDesignerDpiUnaware>
    <ApplicationIcon>..\..\assets\branding\app.ico</ApplicationIcon>
    <Authors>See CREDITS.md</Authors>
    <Description>A modernized, AI-assisted fork of the CK2 Portrait Builder.</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="log4net.config" />
    <None Remove="UI\unknown_character.ico" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="log4net.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="UI\unknown_character.ico" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\branding\app.ico" LogicalName="app.ico" />
    <EmbeddedResource Include="..\..\assets\branding\logo-256.png" LogicalName="logo-256.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Log4Net.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PortraitBuilder.Parser\PortraitBuilder.Parser.csproj" />
    <ProjectReference Include="..\PortraitBuilder.Shared\PortraitBuilder.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="UI\ImportDialog.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="UI\ImportDialog.Designer.cs">
      <DependentUpon>ImportDialog.cs</DependentUpon>
    </Compile>
    <Compile Update="UI\PortraitBuilderForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="UI\PortraitBuilderForm.Designer.cs">
      <DependentUpon>PortraitBuilderForm.cs</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="UI\ImportDialog.resx">
      <DependentUpon>ImportDialog.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="UI\PortraitBuilderForm.resx">
      <DependentUpon>PortraitBuilderForm.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

</Project>

